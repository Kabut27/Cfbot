{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Ec2ReadAndControl",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeRegions",
        "ec2:DescribeInstances",
        "ec2:DescribeAddresses",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeManagedPrefixLists",
        "ec2:DescribeLaunchTemplates",
        "ec2:DescribeVolumes",
        "ec2:DeleteVolume",
        "ec2:DescribeSnapshots",
        "ec2:DeleteSnapshot",
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:RebootInstances",
        "ec2:RunInstances",
        "ec2:CreateTags",
        "ec2:CreateSnapshots",
        "ec2:CreateSnapshot",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:AllocateAddress",
        "ec2:AssociateAddress",
        "ec2:DisassociateAddress",
        "ec2:ReleaseAddress",
        "cloudwatch:GetMetricStatistics"
      ],
      "Resource": "*"
    },
    {
      "Sid": "TerminateOptional",
      "Effect": "Allow",
      "Action": ["ec2:TerminateInstances"],
      "Resource": "*"
    },
    {
      "Sid": "SsmRunCommandOptional",
      "Effect": "Allow",
      "Action": [
        "ssm:DescribeInstanceInformation",
        "ssm:SendCommand",
        "ssm:GetCommandInvocation"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PassRoleForLaunchTemplates",
      "Effect": "Allow",
      "Action": ["iam:PassRole"],
      "Resource": "*"
    }
  ]
}
